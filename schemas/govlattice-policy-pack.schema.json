{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "govlattice-policy-pack.schema.json",
  "title": "GovLattice Policy Pack",
  "description": "Schema for policy-pack manifests generated by GovLattice.",
  "type": "object",
  "required": [
    "pack_schema_version",
    "policy_pack"
  ],
  "additionalProperties": false,
  "properties": {
    "pack_schema_version": {
      "type": "string",
      "const": "1.0.0"
    },
    "policy_pack": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version",
        "enabled",
        "jurisdiction",
        "tags",
        "policies"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "jurisdiction": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "policies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_entry"
          }
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/metadata_value"
      }
    }
  },
  "$defs": {
    "policy_entry": {
      "type": "object",
      "required": [
        "id",
        "file",
        "enabled",
        "severity",
        "schema_version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "file": {
          "type": "string",
          "pattern": "^policies/[A-Za-z0-9][A-Za-z0-9._-]*\\.yml$"
        },
        "enabled": {
          "type": "boolean"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ]
        },
        "schema_version": {
          "const": "1.4.0"
        }
      }
    },
    "metadata_value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metadata_value"
          }
        }
      ]
    }
  }
}
