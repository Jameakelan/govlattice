{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "govlattice-policy.schema.json",
  "title": "GovLattice Policy",
  "description": "Schema for policy files generated by GovLattice.",
  "type": "object",
  "required": [
    "schema_version",
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.2.0"
    },
    "policy": {
      "type": "object",
      "required": [
        "name",
        "enabled",
        "tags",
        "states"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/metadata_value"
      },
      "propertyNames": {
        "not": {
          "const": "schema_version"
        }
      },
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "enabled": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/state"
          }
        }
      }
    }
  },
  "$defs": {
    "metadata_value": {
      "anyOf": [
        {
          "type": [
            "string",
            "number",
            "boolean",
            "null"
          ]
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metadata_value"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/metadata_value"
          }
        }
      ]
    },
    "state": {
      "type": "object",
      "required": [
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "segments": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/segment"
          }
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "when",
        "requirements"
      ],
      "additionalProperties": false,
      "properties": {
        "when": {
          "$ref": "#/$defs/between_condition"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement"
          }
        }
      }
    },
    "between_condition": {
      "type": "object",
      "required": [
        "type",
        "column",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "between"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    },
    "requirement": {
      "oneOf": [
        {
          "$ref": "#/$defs/columns_requirement"
        },
        {
          "$ref": "#/$defs/missing_rate_requirement"
        },
        {
          "$ref": "#/$defs/range_requirement"
        }
      ]
    },
    "columns_requirement": {
      "type": "object",
      "required": [
        "type",
        "columns"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "require_columns",
            "require_unique"
          ]
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "missing_rate_requirement": {
      "type": "object",
      "required": [
        "type",
        "column",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "require_missing_rate"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "maximum": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "range_requirement": {
      "type": "object",
      "required": [
        "type",
        "column",
        "minimum",
        "maximum"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "require_range"
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        }
      }
    }
  }
}
