{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "govlattice-policy.schema.json",
  "title": "GovLattice Policy",
  "description": "Schema for policy files generated by GovLattice.",
  "type": "object",
  "required": [
    "policy"
  ],
  "additionalProperties": false,
  "properties": {
    "policy": {
      "type": "object",
      "required": [
        "name",
        "states"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "states": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": [
              "requirements"
            ],
            "additionalProperties": false,
            "properties": {
              "requirements": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "type",
                    "columns"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "enum": [
                        "require_columns",
                        "require_unique"
                      ]
                    },
                    "columns": {
                      "type": "array",
                      "minItems": 1,
                      "uniqueItems": true,
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
